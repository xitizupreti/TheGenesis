# Copy this file to .env.local for local development:  cp .env.example .env.local
# On Vercel, add the same keys in Project → Settings → Environment Variables.

# ---------- Site URL (SEO, link previews, sitemap) ----------
# Optional on Vercel (it falls back to the production URL automatically).
# Set it when you add a custom domain.
NEXT_PUBLIC_BASE_URL=https://thegenesis-ksus.vercel.app

# ---------- Google Search Console (optional) ----------
# Search Console → Add property → "HTML tag" method → paste only the content="..." value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---------- Contact form (required for the form to send emails) ----------
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourbandemail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Inbox that receives contact form messages (comma-separate for several)
CONTACT_TO=yourbandemail@gmail.com
